# Names only. Never commit real values. Validated at server start (src/lib/env.ts).

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required in production, 32+ chars: openssl rand -hex 32
SESSION_SECRET=

# Database: Railway Postgres (or any Postgres). Run `pnpm db:migrate` then `pnpm db:seed`.
DATABASE_URL=

# AI extraction. OpenAI is the default provider. With no key, on-device OCR + a parser is used.
OPENAI_API_KEY=
AI_MODEL_VISION=gpt-4o
AI_MODEL_TEXT=gpt-4o-mini
# Optional alternative provider (takes precedence over OpenAI when set)
ANTHROPIC_API_KEY=

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox).
# Without client id/secret a clearly labelled payout simulator runs instead.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Receipts on S3. Credentials are NOT read by the app: the AWS SDK default chain is used
# (`aws configure` locally; AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars on Vercel).
AWS_REGION=
S3_BUCKET_NAME=

# Email notifications (optional; all four or none). Gmail needs an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Demo workspace sandbox receivers (comma separated sandbox personal accounts)
DEMO_PAYPAL_RECEIVERS=
DEMO_PAYPAL_SENDER=
# Password for the seeded demo logins (pnpm db:seed). Defaults to a value printed in the README.
DEMO_PASSWORD=

# Slack intake through Zapier (header x-settleshort-secret)
ZAPIER_WEBHOOK_SECRET=

# Safety caps in cents for new workspaces
MAX_SINGLE_PAYOUT_CENTS=50000
MAX_BATCH_TOTAL_CENTS=200000

# Daily escalation cron (Vercel sends it as a Bearer token)
CRON_SECRET=

# Day boundary for "today"/"yesterday" in messages that arrive without a browser time zone (Zapier/Slack). IANA name.
APP_TIMEZONE=Asia/Kolkata
