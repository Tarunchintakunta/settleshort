# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Long random string used to sign session cookies: openssl rand -hex 32
SESSION_SECRET=

# Database (Neon or Railway Postgres). Run `pnpm db:migrate` after setting it.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Extraction. Pick at most one key; with neither, on-device Tesseract OCR is used (no key needed).
ANTHROPIC_API_KEY=
AI_MODEL_CLAUDE=claude-opus-5-5
OPENAI_API_KEY=
AI_MODEL_VISION=gpt-4o
AI_MODEL_TEXT=gpt-4o-mini

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox).
# Without these, a clearly labelled payout simulator runs instead.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Receipt storage on AWS S3 (required for uploads; without these the upload API returns 503 "S3 not configured").
# On Vercel, if AWS_* names are reserved, use S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_REGION instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# Demo workspace receivers (comma separated sandbox personal accounts for Sam, Rita, Dev, Jules)
DEMO_PAYPAL_RECEIVERS=
DEMO_PAYPAL_SENDER=

# Slack intake through Zapier (header x-settleshort-secret)
ZAPIER_WEBHOOK_SECRET=

# Safety caps in cents for new workspaces
MAX_SINGLE_PAYOUT_CENTS=50000
MAX_BATCH_TOTAL_CENTS=200000
